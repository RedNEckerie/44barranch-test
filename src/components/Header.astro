---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<a class="skip" href="#content">Skip to content</a>
	<nav class="nav" aria-label="Main">
		<a class="brand" href="/" aria-label="44 Bar Ranch home">
			<span class="brand-mark" aria-hidden="true">
				<span class="brand-num">44</span>
				<span class="brand-bar"></span>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		background: #2a1c14;
		border-top: 5px solid #e2b15c;
		border-bottom: 1px solid rgba(226, 177, 92, 0.35);
	}
	.skip {
		position: absolute;
		left: 0.75rem;
		top: 0.5rem;
		padding: 0.4rem 0.7rem;
		background: #f6f1e7;
		color: #2c2118;
		transform: translateY(-150%);
		z-index: 2;
	}
	.skip:focus {
		transform: none;
	}
	.nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		max-width: 72rem;
		margin: 0 auto;
		padding: 0.35rem 1.15rem;
	}
	.brand {
		display: flex;
		align-items: center;
		padding: 0.55rem 0;
		color: #f6f1e7;
		text-decoration: none;
	}
	.brand:hover {
		color: #f6f1e7;
	}
	.brand-mark {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: 2.15rem;
		flex: none;
	}
	.brand-num {
		font-family: Georgia, Palatino, "Palatino Linotype", serif;
		font-weight: 700;
		font-size: 1.35rem;
		letter-spacing: -0.04em;
		line-height: 0.8;
		text-align: center;
	}
	.brand-bar {
		display: block;
		height: 0.22rem;
		margin-top: 0.2rem;
		background: #e2b15c;
		border-radius: 1px;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}
	.internal-links :global(a) {
		color: #f6f1e7;
		padding: 0.75rem 0.8rem;
		border-bottom: 3px solid transparent;
		text-decoration: none;
	}
	.internal-links :global(a:hover) {
		color: #f3e2c0;
	}
	.internal-links :global(a.active) {
		border-bottom-color: #e2b15c;
		text-decoration: none;
	}
	@media (max-width: 560px) {
		.internal-links {
			width: 100%;
			border-top: 1px solid rgba(246, 241, 231, 0.14);
		}
		.internal-links :global(a) {
			padding: 0.65rem 0.85rem 0.65rem 0;
		}
	}
</style>
