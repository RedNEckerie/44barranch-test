---
const year = new Date().getFullYear();
---

<footer>
	<p class="footer-name">44 Bar Ranch</p>
	<p class="footer-line">A small family ranch in rural Texas.</p>
	<p class="footer-line">
		<a href="https://x.com/RedNeckerie" rel="noopener noreferrer">Jay on X (@RedNeckerie)</a>
	</p>
	<p class="legal">&copy; {year} 44 Bar Ranch</p>
</footer>

<style>
	footer {
		margin-top: auto;
		padding: 2.25rem 1.25rem 2.75rem;
		background: #2a1c14;
		color: #f0e4d4;
		text-align: center;
	}
	.footer-name {
		margin: 0 0 0.35rem;
		font-family: Georgia, Palatino, "Palatino Linotype", serif;
		font-size: 1.35rem;
		color: #f6f1e7;
	}
	.footer-line {
		margin: 0.2rem 0;
	}
	.legal {
		margin: 0.9rem 0 0;
		color: #d9c7b2;
		font-size: 0.95rem;
	}
	a {
		color: #f0d7a2;
	}
	a:hover {
		color: #fff4dd;
	}
</style>
