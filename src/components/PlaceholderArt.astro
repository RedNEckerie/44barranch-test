{kind !== "chickens" && kind !== "turkeys" && kind !== "cattle" && kind !== "dogs" && (
	<svg viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		<rect width="640" height="400" fill="#f3e6d0" />
		<circle cx="500" cy="78" r="28" fill="#e2b15c" />
