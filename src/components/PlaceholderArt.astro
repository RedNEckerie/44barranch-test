		<ellipse cx="250" cy="224" rx="90" ry="50" fill="#c4a574" stroke="#3a2a1c" stroke-width="5" />
		<ellipse cx="190" cy="236" rx="38" ry="44" fill="#c4a574" stroke="#3a2a1c" stroke-width="5" />
